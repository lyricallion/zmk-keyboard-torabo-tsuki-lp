#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                                                &kp N6           &kp N7    &kp N8     &kp N9     &kp N0          &kp BSPC
&kp TAB    &kp Q      &kp W      &kp E      &kp R      &kp T                                                 &kp Y            &kp U     &kp I      &kp O      &kp P           &kp BSPC
&kp CAPS   &kp A      &kp S      &kp D      &kp F      &kp G        &mkp LCLK              &mkp RCLK         &kp H            &kp J     &kp K      &kp L      &kp UNDERSCORE  &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C      &kp V      &kp B        &kp LEFT_GUI           &kp RET           &kp N            &kp M     &mkp LCLK  &mkp RCLK  &kp ENTER       &kp RSHFT
&kp LCTRL  &kp LCTRL  &kp COMMA  &kp COMMA  &lt 1 TAB  &lt 2 SPACE  &lt 3 INTERNATIONAL_2  &lt 1 LANGUAGE_5  &lt 2 BACKSPACE  &kp BSPC  &kp RALT   &kp RGUI   &lt 3 ESC       &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans             &trans        &trans          &trans           &trans                                   &trans            &trans                &trans                 &trans         &trans            &trans
&trans  &kp DOLLAR         &kp PERCENT   &kp AMPERSAND   &kp APOSTROPHE   &kp SLASH                                &trans            &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LESS_THAN  &kp GREATER_THAN  &trans
&trans  &kp DOUBLE_QUOTES  &kp HASH      &kp ASTERISK    &kp PLUS         &kp EQUAL        &trans  &trans          &kp MINUS         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp COLON         &trans
&trans  &kp GRAVE          &kp TILDE     &kp AT_SIGN     &kp EXCLAMATION  &kp QUESTION     &trans  &trans          &kp INT_YEN       &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans         &trans            &trans
&trans  &trans             &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_LEFT   &msc SCRL_RIGHT  &trans  &kp INT_HENKAN  &kp INT_MUHENKAN  &trans                &trans                 &trans         &trans            &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans            &trans                  &trans                  &trans                &trans                                             &trans          &trans        &trans        &trans        &trans      &trans
&trans  &trans            &trans                  &kp UP_ARROW            &trans                &kp ASTERISK                                       &kp LS(N6)      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS    &trans
&trans  &kp LG(D)         &kp LEFT_ARROW          &kp DOWN_ARROW          &kp RIGHT_ARROW       &kp SLASH                &trans         &trans     &kp LEFT_BRACE  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS   &trans
&trans  &kp SLASH         &kp LS(LC(LEFT_ARROW))  &kp LS(LC(DOWN_ARROW))  &kp LS(LC(UP_ARROW))  &kp LC(LS(RIGHT_ARROW))  &trans         &trans     &kp NUMBER_0    &kp N1        &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD  &trans
&trans  &kp LEFT_CONTROL  &kp LEFT_SHIFT          &kp LEFT_GUI            &kp DEL               &kp ENTER                &kp BACKSPACE  &kp EQUAL  &trans          &trans        &trans        &trans        &lt 3 ESC   &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans                &trans      &trans        &trans      &trans                              &trans                   &trans               &trans           &trans             &trans              &trans
&trans  &kp TAB               &kp F7      &kp F8        &kp F9      &kp F10                             &trans                   &kp PRINTSCREEN      &trans           &trans             &kp LA(LC(DELETE))  &trans
&trans  &trans                &kp F4      &kp F5        &kp F6      &kp F11       &trans        &trans  &kp LANG_ZENKAKUHANKAKU  &kp CAPSLOCK         &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &kp LC(LS(SPACE))   &trans
&trans  &kp LS(LEFT_CONTROL)  &kp F1      &kp F2        &kp F3      &kp F12       &trans        &trans  &kp LA(LEFT_ARROW)       &kp LA(RIGHT_ARROW)  &kp LC(LS(TAB))  &kp LC(TAB)        &kp RETURN          &trans
&trans  &kp LEFT_CONTROL      &kp LSHIFT  &kp LEFT_ALT  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans                   &trans               &trans           &trans             &trans              &trans
            >;
        };
    };
};
